{
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": null,
  "installCommand": "npm ci --ignore-scripts",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "afridi-walima.vercel.app"
        }
      ],
      "destination": "/walima/",
      "permanent": false
    }
  ],
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/rsvp.js": {
      "maxDuration": 30
    },
    "api/rsvp-sync.js": {
      "maxDuration": 60
    }
  }
}
